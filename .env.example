# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP_RECIPIENT_PHONE: Configure the intended recipient's phone number
# in international format without a plus sign, spaces, or punctuation (e.g. 919876543210).
# Leave empty to configure via UI or shareable URL.
VITE_WHATSAPP_RECIPIENT_PHONE=""
